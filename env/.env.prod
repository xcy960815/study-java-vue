#### 正式环境配置

# 前端端口
VITE_PORT = 8083
# 前端路径
# VITE_BASE_URL = '/study-java-vue/'
VITE_BASE_URL = './'
# 后端接口地址
VITE_API_SERVER_DOMAIN = 'http://127.0.0.1:12317'
# VITE_API_SERVER_DOMAIN = 'http://study-java-container:12317'
# 前端接口代理前缀
VITE_API_DOMAIN_PREFIX = '/prod-api'
# 后端接口API前缀
VITE_API_SERVER_DOMAIN_PREFIX = '/prod-api'
# 项目名称
VITE_APP_TITLE = 'study-java-vue'

# Docker Compose
VUE_WEB_IMAGE_NAME=xcy960815/study-java-vue
VUE_WEB_IMAGE_VERSION=latest
VUE_WEB_PORT=12315
TIMEZONE=Asia/Shanghai
DOCKER_NETWORK_NAME=study-java-network
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
